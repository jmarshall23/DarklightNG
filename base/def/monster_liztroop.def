/***********************************************************************

	DNF assault trooper / liztroop

***********************************************************************/

model model_liztroop {
	mesh						models/md5/monsters/liztroop/assaulttrooper.md5mesh

	channel torso				( *spine )
	channel legs				( *Root movement -*spine )

	anim af_pose				models/md5/monsters/liztroop/anims/astr_a_combat_idle01.md5anim
	anim ik_pose				models/md5/monsters/liztroop/anims/astr_a_combat_idle01.md5anim
	anim idle					models/md5/monsters/liztroop/anims/astr_a_combat_idle01.md5anim
	anim walk					models/md5/monsters/liztroop/anims/astr_a_combat_walk.md5anim
	anim run					models/md5/monsters/liztroop/anims/astr_a_combat_run.md5anim
	anim fire					models/md5/monsters/liztroop/anims/astr_a_combat_fire.md5anim
	anim jet_idle				models/md5/monsters/liztroop/anims/astr_a_combat_jet_idle01.md5anim
	anim jet_forward			models/md5/monsters/liztroop/anims/astr_a_combat_jet_forward.md5anim
	anim jet_fire				models/md5/monsters/liztroop/anims/astr_a_combat_jet_fire.md5anim
	anim takeoff				models/md5/monsters/liztroop/anims/astr_a_combat_jetpack_takeoff.md5anim
	anim landing				models/md5/monsters/liztroop/anims/astr_a_combat_jetpack_landing.md5anim
	anim melee_attack			models/md5/monsters/liztroop/anims/astr_a_combat_attack01.md5anim
	anim pain					models/md5/monsters/liztroop/anims/pain_short_front.md5anim
	anim teleport_out			models/md5/monsters/liztroop/anims/astr_a_combat_roar.md5anim
	anim teleport_in			models/md5/monsters/liztroop/anims/astr_a_combat_flip.md5anim
	anim cloak_start			models/md5/monsters/liztroop/anims/astr_a_combat_cloakstart.md5anim
	anim cloak_stop				models/md5/monsters/liztroop/anims/astr_a_combat_cloakstop.md5anim
	anim cloak_idle				models/md5/monsters/liztroop/anims/astr_a_combat_cloak_idle01.md5anim
	anim death					models/md5/monsters/liztroop/anims/scr_a_splitdoor_death.md5anim
}

model model_liztroop_grunt_gun {
	mesh						models/md5/monsters/liztroop/weapons/grunt/at_gun.md5mesh
	anim idle					models/md5/monsters/liztroop/weapons/grunt/anims/idle.md5anim
	anim fire					models/md5/monsters/liztroop/weapons/grunt/anims/fire.md5anim
	anim activate				models/md5/monsters/liztroop/weapons/grunt/anims/activate.md5anim
	anim deactivate			models/md5/monsters/liztroop/weapons/grunt/anims/deactivate.md5anim
}

model model_liztroop_captain_gun {
	mesh						models/md5/monsters/liztroop/weapons/captain/at_capt_gun.md5mesh
	anim idle					models/md5/monsters/liztroop/weapons/captain/anims/idle.md5anim
	anim fire					models/md5/monsters/liztroop/weapons/captain/anims/fire.md5anim
	anim fire_start			models/md5/monsters/liztroop/weapons/captain/anims/fire_start.md5anim
	anim fire_stop				models/md5/monsters/liztroop/weapons/captain/anims/fire_stop.md5anim
	anim activate				models/md5/monsters/liztroop/weapons/captain/anims/activate.md5anim
	anim deactivate			models/md5/monsters/liztroop/weapons/captain/anims/deactivate.md5anim
}

