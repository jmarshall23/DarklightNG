	anim handgrenade_throw_start	models/md5/player/anims/ai_a_ready_fists_stand_melee01.md5anim
	anim handgrenade_throw			models/md5/player/anims/ai_a_ready_fists_stand_melee01.md5anim
	anim handgrenade_startfire		models/md5/player/anims/ai_a_ready_fists_stand_melee01.md5anim
	anim handgrenade_fire			models/md5/player/anims/ai_a_ready_fists_stand_melee01.md5anim
