	anim reload_loop1	models/weapons2/shotgun/anims/shotgun_reload.md5anim
	anim reload_loop2	models/weapons2/shotgun/anims/shotgun_reload.md5anim
	anim reload_loop3	models/weapons2/shotgun/anims/shotgun_reload.md5anim
	anim reload_end		models/weapons2/shotgun/anims/shotgun_reload_stop.md5anim
	anim noammo			models/weapons2/shotgun/anims/shotgun_idle.md5anim
