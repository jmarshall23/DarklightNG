model worldmodel_duke_pistol {
	mesh models/weapons2/pistol/pistol.md5mesh
	anim raise		models/weapons2/pistol/anims/pistol_activate.md5anim
	anim idle		models/weapons2/pistol/anims/pistol_idle.md5anim
	anim idle_empty	models/weapons2/pistol/anims/pistol_idle.md5anim
	anim fire1		models/weapons2/pistol/anims/pistol_fire.md5anim
	anim reload		models/weapons2/pistol/anims/pistol_reload.md5anim
	anim noammo		models/weapons2/pistol/anims/pistol_idle.md5anim
	anim putaway		models/weapons2/pistol/anims/pistol_deactivate.md5anim
}

