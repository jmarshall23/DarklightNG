	"size"						"48 48 82"
	"use_combat_bbox"				"1"
	"use_aas"						"aas48"
	"team"						"1"
	"rank"						"1"
	"health"						"100"
	"mass"						"160"
	"melee_range"					"60"
	"def_melee"					"melee_pigcop"
	"def_melee_berserk"			"melee_pigcop_berserk"
	"def_projectile"				"projectile_pigcop_bullet"
	"attack_cone"					"70"
	"attack_accuracy"				"4"
	"turn_rate"						"240"
	"fly_speed"						"280"
	"bone_focus"					"head"
	"bone_orientation"				"Root"
	"pain_delay"					"0.35"
	"pain_threshold"				"10"

	"pig_ground_speed"				"280"
	"pig_berserk_speed"				"360"
	"pig_max_attack_range"			"1000"
	"pig_burst_min"					"10"
	"pig_burst_random"				"6"
	"pig_burst_interval"				"0.05"
	"pig_volley_delay"				"0.5"
	"pig_berserk_health_fraction"	"0.45"
	"pig_berserk_chance"				"0.5"

	"damage_zone head"				"*head"
	"damage_zone chest"				"*spine_base -*arm_left_upper_a -*arm_right_upper_a"
	"damage_zone left_arm"			"*arm_left_upper_a"
	"damage_zone right_arm"			"*arm_right_upper_a"
	"damage_zone legs"				"*hip_left_a *hip_right_a"
	"damage_scale head"				"2"

	"gib"							"1"
	"def_dropGibItem1"				"moveable_item_pigcop_arm_l"
	"dropGibItem1Joint"				"arm_left_upper_a"
	"def_dropGibItem2"				"moveable_item_pigcop_arm_r"
	"dropGibItem2Joint"				"arm_right_upper_a"
	"def_dropGibItem3"				"moveable_item_pigcop_leg_l"
	"dropGibItem3Joint"				"hip_left_a"
	"def_dropGibItem4"				"moveable_item_pigcop_leg_r"
	"dropGibItem4Joint"				"hip_right_a"

	"mtr_flashShader"				"muzzleflash"
	"flashTime"						"0.08"
	"flashColor"					"1 0.72 0.32"
	"flashRadius"					"100"
}

