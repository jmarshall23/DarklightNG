/***********************************************************************

	DNF PigCop (dual pistol grunt and berserker)

***********************************************************************/

model model_pigcop {
	mesh						models/md5/monsters/pigcop/pigcopa.md5mesh

	// The converted DNF skeleton is breadth-first rather than depth-first, so
	// Doom's *joint subtree shorthand stops at the next interleaved leg joint.
	// Keep the two animation channels explicit or idle/fire can combine an
	// upper-body frame with leg joints from the wrong local frame.
	channel torso				(
		spine_base spine_lower spine_mid spine_upper
		shoulder_left neck mount_holster_rpg shoulder_right
		mount_holster_shotgun mount_holster_machinegun
		arm_left_upper_a head arm_right_upper_a jaw
		arm_left_lower_a arm_right_lower_a arm_left_lower_b arm_right_lower_b
		hand_left_a hand_right_a
		thumb_left_lower finger_index_left_lower finger_middle_left_lower
		mount_pipebomb_l mount_carryitem mount_pistol_l
		thumb_right_lower finger_index_right_lower finger_middle_right_lower
		mount_rpg_r mount_extinguisher mount_shotgun_r mount_pistol_r
		mount_pipebomb_r mount_machinegun_r mount_carryitem_r
		thumb_left_upper finger_index_left_upper finger_middle_left_upper
		thumb_right_upper finger_index_right_upper finger_middle_right_upper
	)
	channel legs				(
		Root movement waist mount_crotch
		hip_left_a hip_right_a mount_holster_pistol mount_holster_pistol2
		knee_left_a knee_right_a heel_left_a heel_right_a ball_left_a ball_right_a
	)

	anim af_pose				models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_idle.md5anim
	anim ik_pose				models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_idle.md5anim
	anim idle					models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_idle.md5anim
	anim walk					models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_walk.md5anim
	anim run					models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_run.md5anim
	anim fire_left				models/md5/monsters/pigcop/anims/u_combat_dualpistol_stand_fire_left.md5anim {
		prevent_idle_override
	}
	anim fire_right			models/md5/monsters/pigcop/anims/u_combat_dualpistol_stand_fire_right.md5anim {
		prevent_idle_override
	}
	anim melee					models/md5/monsters/pigcop/anims/a_combat_dualpistol_stand_melee_01.md5anim
	anim pain					models/md5/monsters/pigcop/anims/pain_dualpistol_short_front.md5anim
	anim death					models/md5/monsters/pigcop/anims/a_execution_start.md5anim
	anim berserk_start			models/md5/monsters/pigcop/anims/a_combat_berserk_roar_01.md5anim
	anim berserk_idle			models/md5/monsters/pigcop/anims/a_combat_berserk_idle_01.md5anim
	anim berserk_run			models/md5/monsters/pigcop/anims/a_combat_berserk_run_01.md5anim
	anim berserk_attack1		models/md5/monsters/pigcop/anims/a_combat_berserk_attack_01.md5anim
	anim berserk_attack2		models/md5/monsters/pigcop/anims/a_combat_berserk_attack_02.md5anim
	anim berserk_attack3		models/md5/monsters/pigcop/anims/a_combat_berserk_attack_03.md5anim
}

model model_pigcop_shotgun {
	inherit					model_pigcop

	anim af_pose				models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_scared_idle.md5anim
	anim ik_pose				models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_scared_idle.md5anim
	anim idle				models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_scared_idle.md5anim
	anim walk				models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_scared_run.md5anim
	anim run					models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_scared_run.md5anim
	anim fire_left			models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_fire_baked.md5anim {
		prevent_idle_override
	}
	anim fire_right			models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_fire_baked.md5anim {
		prevent_idle_override
	}
	anim melee				models/md5/monsters/pigcop/anims/a_combat_shotgun_stand_melee_01.md5anim
	anim pain				models/md5/monsters/pigcop/anims/pain_shotgun_short_front.md5anim
	anim death				models/md5/monsters/pigcop/anims/a_execution_start.md5anim
}

model model_pigcop_pistol {
	mesh						models/md5/monsters/pigcop/weapons/pistol/pistol.md5mesh
	anim idle					models/md5/monsters/pigcop/weapons/pistol/anims/dualpistol_idle.md5anim
	anim fire					models/md5/monsters/pigcop/weapons/pistol/anims/dualpistol_fire.md5anim
}

model model_pigcop_shotgun_weapon {
	mesh						models/md5/monsters/pigcop/weapons/shotgun/shotgun.md5mesh
	anim idle					models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_idle.md5anim
	anim fire					models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_fire.md5anim
	anim melee				models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_melee.md5anim
	anim activate				models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_activate.md5anim
	anim deactivate			models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_deactivate.md5anim
	anim reload				models/md5/monsters/pigcop/weapons/shotgun/anims/shotgun_reload.md5anim
}

entityDef pigcop_attachment_pistol_left {
	"spawnclass"					"idAnimated"
	"model"						"model_pigcop_pistol"
	"joint"						"mount_pistol_l"
	"start_anim"					"idle"
	"sound_bone"					"Root"
	"remove"						"1"
}

entityDef pigcop_attachment_pistol_right {
	"spawnclass"					"idAnimated"
	"model"						"model_pigcop_pistol"
	"joint"						"mount_pistol_r"
	"start_anim"					"idle"
	"sound_bone"					"Root"
	"remove"						"1"
}

entityDef pigcop_attachment_shotgun {
	"spawnclass"					"idAnimated"
	"model"						"model_pigcop_shotgun_weapon"
	"joint"						"mount_shotgun_r"
	"start_anim"					"idle"
	"sound_bone"					"Root"
	"remove"						"1"
}

