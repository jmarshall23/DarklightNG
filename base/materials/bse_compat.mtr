/*
===========================================================================

Material aliases for the ETQW BSE effects used by DarklightNG weapons.
The SDK effect declarations are kept unmodified; these aliases bind their
material names to artwork already shipped in the Darklight base data.

===========================================================================
*/

textures/effects/weapons/muzzle_flash
{
	translucent
	noShadows
	nonsolid
	{
		blend add
		map textures/particles/boomboom.tga
		vertexColor
	}
}

textures/effects/weapons/muzzle_flash2
{
	translucent
	noShadows
	nonsolid
	{
		blend add
		map textures/particles/boomboom.tga
		vertexColor
	}
}

